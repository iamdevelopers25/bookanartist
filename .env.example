PORT=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Empty for a local root account with no password.
# Set to root when using the docker-compose file in this repo.
MYSQL_PASSWORD=
MYSQL_DATABASE=bookanartist
MYSQL_POOL_SIZE=10

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=bookanartist

# Local placeholder only. Use a long random value outside this exercise.
JWT_SECRET=local-dev-only-change-me
JWT_EXPIRES_IN=8h
